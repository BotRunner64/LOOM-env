#usda 1.0
(
    customLayerData = {
        string source_sha256 = "f1c48a594f6348cc7dca8f2191e2992b815075aa932e0ec743d03843e1e717e9"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @object.usdz@
)
{
    float physics:mass = 0.02

    def Material "LoomPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0
        float physics:restitution = 0
        float physics:staticFriction = 0
    }

    over "collision" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Asset/LoomPhysics> (
            bindMaterialAs = "strongerThanDescendants"
        )
    }

    over "Cylinder" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Asset/LoomPhysics> (
            bindMaterialAs = "strongerThanDescendants"
        )
    }

    over "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Asset/LoomPhysics> (
            bindMaterialAs = "strongerThanDescendants"
        )
    }
}

