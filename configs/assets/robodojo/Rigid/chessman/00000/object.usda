#usda 1.0
(
    customLayerData = {
        string source_sha256 = "df00d91f5ab3d172ad8699751be9a5b3b6115eb1702e8a6c65da29470151d550"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @object.usdz@
)
{
    float physics:mass = 0.1

    def Material "LoomPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.15
        float physics:restitution = 0
        float physics:staticFriction = 0.15
    }

    over "Hunker"
    {
        over "Cylinder"
        {
            over "Cylinder" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Asset/LoomPhysics> (
                    bindMaterialAs = "strongerThanDescendants"
                )
            }
        }
    }
}

