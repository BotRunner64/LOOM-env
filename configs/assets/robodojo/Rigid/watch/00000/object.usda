#usda 1.0
(
    customLayerData = {
        string source_sha256 = "6c7da110e76bccdedad240e838382b8cc3631863611a7e9f30672333536aad7b"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @object.usdz@
)
{
    float physics:mass = 0.035

    def Material "LoomPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.75
        float physics:restitution = 0
        float physics:staticFriction = 0.75
    }

    over "Screen"
    {
        over "Screen_001" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/LoomPhysics> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        over "Belt2"
        {
            over "Belt2_001" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Asset/LoomPhysics> (
                    bindMaterialAs = "strongerThanDescendants"
                )
            }
        }

        over "Belt1"
        {
            over "Belt1_001" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Asset/LoomPhysics> (
                    bindMaterialAs = "strongerThanDescendants"
                )
            }
        }
    }
}

