#usda 1.0
(
    customLayerData = {
        string source_sha256 = "d6c002ded6059ce40a64fc8203dc8bfcad29b0243eee3fbaf1c07f175758279a"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @object.usdz@
)
{
    float physics:mass = 0.045

    def Material "LoomPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.65
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    over "collision"
    {
        over "model" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/LoomPhysics> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }
    }
}

