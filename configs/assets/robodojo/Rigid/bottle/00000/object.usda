#usda 1.0
(
    customLayerData = {
        string source_sha256 = "3a2ea65ba9d44eaab2f1916b8ddf599d9d4a8a62181bc28ed3036062073aac57"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @object.usdz@
)
{
    float physics:mass = 0.19

    def Material "LoomPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.32
        float physics:restitution = 0
        float physics:staticFriction = 0.32
    }

    over "collision"
    {
        over "model" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/LoomPhysics> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }
    }
}

