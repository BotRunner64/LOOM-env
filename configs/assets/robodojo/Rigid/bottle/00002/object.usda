#usda 1.0
(
    customLayerData = {
        string source_sha256 = "f826b43ecd2035b86af53181711f73cf5a08d7d8c8339e466d0a7d47edc2241e"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @object.usdz@
)
{
    float physics:mass = 0.19

    def Material "LoomPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.38
        float physics:restitution = 0
        float physics:staticFriction = 0.38
    }

    over "collision"
    {
        over "model" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/LoomPhysics> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }
    }
}

