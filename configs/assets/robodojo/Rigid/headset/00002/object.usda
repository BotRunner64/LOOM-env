#usda 1.0
(
    customLayerData = {
        string source_sha256 = "0839dfedd5b2b12c2679388325f8714f2bec7e9479086db6e7577dcb9a5c7b99"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @object.usdz@
)
{
    float physics:mass = 0.32

    def Material "LoomPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.55
        float physics:restitution = 0
        float physics:staticFriction = 0.55
    }

    over "collision"
    {
        over "model" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/LoomPhysics> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        over "Cylinder" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/LoomPhysics> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        over "Cylinder_01" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/LoomPhysics> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }
    }
}

