#usda 1.0
(
    customLayerData = {
        string source_sha256 = "3e2c31983dfe1b72d8ca7a7f9a757226baeaac7976a7c47acd10134ae59cd428"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @object.usdz@
)
{
    float physics:mass = 0.05

    def Material "LoomPhysics" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.32
        float physics:restitution = 0
        float physics:staticFriction = 0.32
    }

    over "collision"
    {
        over "model" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/LoomPhysics> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }
    }
}

